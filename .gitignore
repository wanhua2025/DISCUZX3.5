# 排除 uc_server 文件夹
uc_server/

# 排除附件和图片目录
data/attachment/
data/avatar/

# 排除缓存和日志文件
data/cache/
data/log/
data/threadcache/
data/template/
source/plugin/
# 排除临时文件
data/download/
data/plugindata/

# 排除大文件（大于 50MB 的文件会在脚本中处理）
