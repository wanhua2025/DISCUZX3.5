*.zip
*.rar
*.7z
*.tar.gz
*.tar
*.gz
*.iso
*.dmg
*.exe
*.msi
*.deb
*.rpm

# 排除数据库备份文件
*.sql
*.sql.gz
*.bak

# 排除系统文件
.DS_Store
Thumbs.db
desktop.ini

# 排除 IDE 文件
.idea/
.vscode/
*.swp
*.swo
*~

# 排除其他临时文件
*.tmp
*.temp
*.log

